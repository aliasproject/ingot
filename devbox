#!/usr/bin/env bash

# Set environment variables
export APP_PORT=${APP_PORT:-80}
export DB_PORT=${DB_PORT:-3306}

COMPOSE="docker compose -f $HOME/Projects/Docker/devbox/docker-compose.yml"
DIR=$(pwd | sed 's/.*\///')
DIR_EXISTS=$($COMPOSE exec php sh -c "test -d /home/alias/$DIR && echo true")
APP_EXEC="$COMPOSE exec -w /home/alias/$DIR php sh -c"

if [ $# -gt 0 ]; then
    if [ $DIR_EXISTS ]; then
        # Artisan
        if [ "$1" == "artisan" ]; then
            shift 1
            $APP_EXEC "php artisan $@"
            exit 0
        fi

        # Composer
        if [ "$1" == "composer" ]; then
            shift 1
            $APP_EXEC "composer $@"
            exit 0
        fi

        # Composer
        if [ "$1" == "npm" ]; then
            shift 1
            echo "$@"

            $APP_EXEC "npm $@"
            exit 0
        fi

        $APP_EXEC "$(echo $@)"
    else
        echo "The directory $DIR doesn't exist!"
    fi
else
    $COMPOSE ps
fi
