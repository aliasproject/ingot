#!/usr/bin/env bash

set -e

VERSION=0.2.0
COMPOSE="docker compose -f $HOME/.devbox/docker-compose.yml"

if [ -d "$HOME/.devbox" ] && [ -f "/usr/local/bin/devbox" ]; then
    # Set ENV Vars
    source ~/.devbox/env_vars

    # Exit if not inside project directory
    case $PWD/ in
      ${DEVBOX_PROJECT_ROOT}*) ;;
      *) echo "Please try again from inside projects directory: ${DEVBOX_PROJECT_ROOT}"; exit;;
    esac

    # Set current path inside Project Root
    DIR=${PWD#*$DEVBOX_PROJECT_ROOT}

    if [ "$1" == "-v" ] || [ "$1" == "--version" ]; then
        echo $VERSION
        exit 0
    else
        if [ $# -gt 0 ]; then
            DIR_EXISTS=$($COMPOSE exec -T php sh -c "test -d /home/alias/${DIR} && echo true || echo false")
            APP_EXEC="$COMPOSE exec -w /home/alias/$DIR php sh -c"

            if [ $DIR_EXISTS == true ]; then
                # Artisan
                if [ "$1" == "artisan" ]; then
                    shift 1
                    $APP_EXEC "php artisan $(echo $@)"
                    exit 0


                # Composer
                elif [ "$1" == "composer" ]; then
                    shift 1
                    $APP_EXEC "composer $(echo $@)"
                    exit 0


                # Composer
                elif [ "$1" == "npm" ]; then
                    shift 1
                    $APP_EXEC "npm $(echo $@)"
                    exit 0

                else
                    $APP_EXEC "$(echo $@)"
                fi
            else
                $COMPOSE "$(echo $@)"
            fi
        else
            $COMPOSE ps
        fi
    fi
else
    echo "devbox is not installed."

    if [ "$1" == "install" ]; then

        # Install Devbox
        echo "Installing devbox..."
        # Check if Docker is installed.

        # Create .devbox directory and copy YML
        mkdir "$HOME/.devbox"
        cp docker-compose.yml $HOME/.devbox/docker-compose.yml

        # Copy CLI
        sudo cp devbox /usr/local/bin/devbox

        # Projects Directory
        while true; do
          read -erp "Please enter the path to your projects directory: " DEVBOX_PROJECT_ROOT
          if [[ "$DEVBOX_PROJECT_ROOT"  != "" ]]
          then
            if [ -d "`eval echo ${DEVBOX_PROJECT_ROOT//>}`" ]; then
                DEVBOX_PROJECT_ROOT=$(echo ${DEVBOX_PROJECT_ROOT} | sed 's![^/]$!&/!')
                echo "export DEVBOX_PROJECT_ROOT=${DEVBOX_PROJECT_ROOT}" > ~/.devbox/env_vars
                source ~/.devbox/env_vars
                break
            fi

            echo "Invalid directory, please try again."
          fi
        done

        # PHP Version
        PS3="Select PHP Version: "
        select php_version in 8.2 8.1 8.0; do
            case $php_version in
                8.0|8.1|8.2)
                    export PHP_VERSION=$php_version;
                    break
                    ;;
                *)
                    echo "Invalid Option"
                    ;;
            esac
        done

        # MySQL Version
        PS3="Select MySQL Version: "
        select mysql_version in 8.0 5.7; do
            case $mysql_version in
                8.0|5.7)
                    export MYSQL_SERVER=$mysql_version;
                    break
                    ;;
                *)
                    echo "Invalid Option"
                    ;;
            esac
        done

        # Configure DNS
        echo "Configuring DNS..."
        if [ ! -d "/etc/resolver" ]; then
            sudo mkdir /etc/resolver
        fi

        if [ ! $(sudo test -f "/etc/resolver/test") ]; then
           echo -e "port 5354\nnameserver 127.0.0.1" | sudo tee -a /etc/resolver/test > /dev/null
        fi

        # Start environment
        echo "Starting Containers..."
        $COMPOSE up -d

        # Wait for Watchman container to start
        echo "Preparing sites..."
        while [ "`docker inspect -f {{.State.Health.Status}} devbox_watchman`" != "healthy" ]; do sleep 0.1; done

        # Trust SSL Root Authority
        echo "Trusting Certificate"
        $COMPOSE cp watchman:/certs/AliasProjectCASelfSigned.pem $HOME/.devbox/AliasProjectCASelfSigned.pem

        # macOS
        sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain $HOME/.devbox/AliasProjectCASelfSigned.pem

        # Installing Composer
        echo "Installing Composer..."
        $COMPOSE exec php sh -c "wget https://getcomposer.org/composer-stable.phar -O /usr/local/bin/composer && chmod +x /usr/local/bin/composer"

        # echo "Installing Build Tools..."
        # $COMPOSE exec php sh -c "apk add --no-cache python2 make automake g++"

        # Installing NPM
        echo "Installing NPM..."
        $COMPOSE exec php sh -c "apk add --no-cache npm"

        # Configure NPM
        # echo "Configuring NPM..."
        # $COMPOSE exec php sh -c "npm config set python /usr/bin/python2"

        echo "devbox installed!"

        exit 0
    fi
fi
