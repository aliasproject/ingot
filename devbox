#!/usr/bin/env bash

set -e

VERSION=0.1.0
COMPOSE="docker compose -f $HOME/.devbox/docker-compose.yml"
DIR=$(pwd | sed 's/.*\///')

if [ -d "$HOME/.devbox" ] && [ -f "/usr/local/bin/devbox" ]; then
    if [ "$1" == "-v" ] || [ "$1" == "--version" ]; then
        echo $VERSION
        exit 0
    else
        if [ $# -gt 0 ]; then
            if [ $DIR_EXISTS ]; then
                DIR_EXISTS=$($COMPOSE exec php sh -c "test -d /home/alias/$DIR && echo true")
                APP_EXEC="$COMPOSE exec -w /home/alias/$DIR php sh -c"

                # Artisan
                if [ "$1" == "artisan" ]; then
                    shift 1
                    $APP_EXEC "php artisan $@"
                    exit 0


                # Composer
                elif [ "$1" == "composer" ]; then
                    shift 1
                    $APP_EXEC "composer $@"
                    exit 0


                # Composer
                elif [ "$1" == "npm" ]; then
                    shift 1
                    $APP_EXEC "npm $@"
                    exit 0

                else
                    echo "?????"
                    $APP_EXEC "$(echo $@)"
                fi
            else
                $COMPOSE "$@"
            fi
        else
            $COMPOSE ps
        fi
    fi
else
    echo "devbox is not installed."

    if [ "$1" == "install" ]; then

        # Install Devbox
        echo "Installing devbox..."
        # Check if Docker is installed.

        # Create .devbox directory and copy YML
        mkdir "$HOME/.devbox"
        cp docker-compose.yml $HOME/.devbox/docker-compose.yml

        # Copy CLI
        sudo cp devbox /usr/local/bin/devbox

        # Projects Directory
        while true; do
          read -erp "Please enter the path to your projects directory: " PROJECT_ROOT
          if [[ "$PROJECT_ROOT"  != "" ]]
          then
            if [ -d "`eval echo ${PROJECT_ROOT//>}`" ]; then
                export PROJECT_ROOT=$PROJECT_ROOT
                break
            fi

            echo "Invalid directory, please try again."
          fi
        done

        # MySQL Version
        PS3="Select MySQL Version: "
        select mysql_version in 8.0 5.7; do
            case $mysql_version in
                8.0|5.7)
                    export MYSQL_SERVER=$mysql_version;
                    break
                    ;;
                *)
                    echo "Invalid Option"
                    ;;
            esac
        done

        # Configure DNS
        echo "Configuring DNS..."
        if [ ! -d "/etc/resolver" ]; then
            sudo mkdir /etc/resolver
        fi

        if [ ! $(sudo test -f "/etc/resolver/test") ]; then
           echo -e "port 5354\nnameserver 127.0.0.1" | sudo tee -a /etc/resolver/test > /dev/null
        fi

        # Start environment
        echo "Starting Containers..."
        $COMPOSE up -d

        # Wait for Watchman container to start
        echo "Preparing sites..."
        while [ "`docker inspect -f {{.State.Health.Status}} devbox_watchman`" != "healthy" ]; do sleep 0.1; done

        # Trust SSL Root Authority
        echo "Trusting Certificate"
        $COMPOSE cp watchman:/certs/AliasProjectCASelfSigned.pem $HOME/.devbox/AliasProjectCASelfSigned.pem

        # macOS
        sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain $HOME/.devbox/AliasProjectCASelfSigned.pem

        echo "devbox installed!"

        exit 0
    fi
fi
